# Скопируйте в .env и заполните значения.
# Имена полей совпадают с src/config.py (Settings).
# DB_PORT и REDIS_PORT опциональны (по умолчанию 5432 и 6379).

# PostgreSQL
DB_HOST=
DB_PORT=
DB_USER=
DB_NAME=
DB_PASS=

# Redis (в Compose — сервис cache)
REDIS_HOST=
REDIS_PORT=

# MinIO (в Compose — сервис minio)
MINIO_USER=
MINIO_PASS=
MINIO_HOST=
MINIO_PORT=

# Grafana (в Compose — сервис grafana)
GF_USER=
GF_PASS=
GF_LOG_LEVEL=

# OpenTelemetry (в Compose — otel-collector, например http://otel-collector:4318)
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Приложение
REQUEST_TIMEOUT=
DEBUG=
